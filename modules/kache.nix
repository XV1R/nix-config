# kache: content-addressed build cache for Rust and C/C++ (work Mac).
# ~/.cargo/config.toml, written by `kache init`, stays unmanaged: it holds
# the work cache backend.
{
  config,
  inputs,
  lib,
  pkgs,
  ...
}: let
  kache = inputs.kache.packages.${pkgs.stdenv.hostPlatform.system}.default;
  logDir = "${config.home.homeDirectory}/Library/Logs/kache";

  # Where `kache init` puts its shims; ~/.cargo/config.toml refers to it
  shimDir = ".local/lib/kache/shims";
  # Compiler names kache intercepts: it dispatches on the name it's run as
  shims = ["c++" "cargo" "cc" "clang" "clang++" "g++" "gcc" "rustdoc"];
in {
  home.packages = [kache];

  # The links `kache init --shims` creates, regenerated by every switch so
  # they always point at the current kache
  home.file =
    lib.genAttrs (map (name: "${shimDir}/${name}") shims) (_: {
      source = "${kache}/bin/kache";
    })
    // {
      # Marks the directory so kache skips it when finding the real compilers
      "${shimDir}/.kache-shims".text = "kache toolchain shims. kache skips this directory when it looks for the real toolchain, so keep only shims here.\n";
    };
  home.sessionPath = lib.mkBefore ["$HOME/${shimDir}"];

  # kache's test runner, unless something already set one
  home.sessionVariables.CARGO_TARGET_AARCH64_APPLE_DARWIN_RUNNER = "\${CARGO_TARGET_AARCH64_APPLE_DARWIN_RUNNER:-kache test-runner}";

  # What `kache daemon install` writes, but pointing at this generation's
  # kache. Same label, so Home Manager replaces kache's own agent and
  # `kache daemon status/restart` still find it.
  launchd.agents.kache = {
    enable = true;
    config = {
      Label = "ninja.kunobi.kache";
      AssociatedBundleIdentifiers = ["ninja.kunobi.kache"];
      ProgramArguments = ["${kache}/bin/kache" "daemon" "run"];
      EnvironmentVariables.KACHE_LOG = "kache=info";
      RunAtLoad = true;
      KeepAlive.SuccessfulExit = false;
      ThrottleInterval = 5;
      StandardOutPath = "${logDir}/out.log";
      StandardErrorPath = "${logDir}/err.log";
    };
  };
}
